{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Office Dashboard",
  "version": "0.1.0",
  "identifier": "com.office365wrapper.dashboard",
  "build": {
    "frontendDist": ["../assets/dashboard/dashboard.html", "../assets/dashboard/dashboard.css", "../assets/dashboard/dashboard-watermark.png", "../assets/dashboard/search.js"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icons/128x128.png", "../assets/icons/256x256.png", "../assets/icons/512x512.png"]
  }
}
